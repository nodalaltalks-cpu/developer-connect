{
  "name": "developer-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --test-concurrency=1 \"src/lib/developer-connect/__tests__/*.test.ts\" \"src/lib/developer-connect/db/__tests__/*.test.ts\" \"src/lib/profile/__tests__/*.test.ts\" \"src/lib/profile/db/__tests__/*.test.ts\" \"src/lib/__tests__/*.test.ts\" \"src/lib/admin-analytics/__tests__/*.test.ts\" \"src/lib/notifications/__tests__/*.test.ts\" \"src/lib/notifications/db/__tests__/*.test.ts\" \"src/app/_actions/__tests__/*.test.ts\" \"src/lib/platform-health/__tests__/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:migrate:test": "dotenv -e .env.local -- node scripts/with-test-database.cjs npx drizzle-kit migrate",
    "db:seed:test": "dotenv -e .env.local -- node --experimental-strip-types src/lib/developer-connect/db/seed-test-data.ts",
    "test:db": "dotenv -e .env.local -- npm test"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
